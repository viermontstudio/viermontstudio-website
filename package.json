{
  "name": "viermontstudio-website",
  "private": true,
  "version": "6.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "esbuild src/scripts/main.ts --bundle --outfile=src/scripts/main.js --format=esm --target=es2020 && vite build",
    "bundle": "esbuild src/scripts/main.ts --bundle --outfile=src/scripts/main.js --format=esm --target=es2020",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
