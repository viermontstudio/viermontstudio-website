# Viermont Studio - LiteSpeed / Apache Security & Performance Configuration
# Diseñado para servidor LiteSpeed / cPanel (Ginernet) con HTTP/2 y PHP 8.x

# ----------------------------------------------------------------------
# 1. PROTECCIÓN DE ARCHIVOS SENSIBLES Y DE DESARROLLO
# Si se despliega el repositorio en public_html, bloquea acceso directo a archivos internos.
# ----------------------------------------------------------------------
<FilesMatch "^(\.env|\.git|package\.json|package-lock\.json|bun\.lock|tsconfig.*\.json|vite\.config\.ts|metadata\.json|composer\.(json|lock)|.*\.log|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloquear acceso a carpetas internas de scripts y documentación
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "^(scripts|docs)(/|$)" - [F,L]
  RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# ----------------------------------------------------------------------
# 2. TIPOS MIME
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/pdf .pdf
  AddType font/woff2 .woff2
</IfModule>

# ----------------------------------------------------------------------
# 3. CABECERAS DE SEGURIDAD (Security Headers)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevenir MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Prevenir Clickjacking (sólo embebible en el mismo dominio)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Enviar origen sólo a destinos HTTPS equivalentes
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: Forzar HTTPS en el dominio principal (seguro para subdominios sin certificado propio)
  Header always set Strict-Transport-Security "max-age=31536000"

  # Restringir permisos de APIs del navegador innecesarias
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy (Modo Report-Only para máxima seguridad sin romper scripts ni fuentes externas)
  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://api.github.com; frame-ancestors 'self';"
</IfModule>

# ----------------------------------------------------------------------
# 4. POLÍTICAS DE CACHÉ Y REVALIDACIÓN
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Para HTML: Permite revalidación 304 rápida (no-cache en vez de no-store)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  
  # Para scripts y hojas de estilo versionadas
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # Para imágenes, documentos y fuentes (inmutables 30 días)
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|pdf|woff2|woff)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 5. COMPRESIÓN GZIP / DEFLATE
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
